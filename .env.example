# Copy this file to .env and fill in the values from the Supabase dashboard
# (Project Settings > API Keys). The publishable key is designed to ship in the
# app; never put the secret key in this file.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Gmail app password for fittracker.noreply@gmail.com, used only by the Supabase
# CLI when it pushes supabase/config.toml. It has no EXPO_PUBLIC_ prefix, so Expo
# never puts it in the app.
SUPABASE_SMTP_PASSWORD=
